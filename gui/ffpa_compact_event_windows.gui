# CMF telegram at journal-like width, using the game's normal font for both languages.
types ffpa_sc_cmf_event_types {
 type ffpa_sc_cmf_telegram = com_event_window_telegram {
  blockoverride "event_name" { name = "ffpa_sc_cmf_telegram" }
  blockoverride "additional_button" {}
  blockoverride "text_header" {
   icon = { size = { 520 133 } texture = "gfx/interface/event_window/com_telegram_header.dds" }
  }
  blockoverride "text_footer" {
   icon = { size = { 520 17 } texture = "gfx/interface/event_window/com_telegram_footer.dds" }
  }
  blockoverride "text_description" {
   textbox = {
    text = "[EventWindow.GetDescription]"
    minimumsize = { 500 -1 }
    maximumsize = { 500 -1 }
    multiline = yes
    autoresize = yes
    align = left|nobaseline
    default_format = "#com_letter"
    margin = { 10 0 }
   }
  }
  blockoverride "text_flavor" {
   textbox = {
    text = "[EventWindow.GetFlavor]"
    minimumsize = { 500 -1 }
    maximumsize = { 500 -1 }
    multiline = yes
    autoresize = yes
    align = left|nobaseline
    default_format = "#com_letter"
    margin = { 10 0 }
   }
  }
 }
}
